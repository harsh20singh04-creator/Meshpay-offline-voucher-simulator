{
  "name": "upi-without-internet",
  "version": "1.0.0",
  "private": true,
  "description": "Security-focused offline payment voucher and settlement simulator; no real UPI connectivity.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"server/**/*.js\" \"client/src/**/*.{js,jsx}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "check": "npm run lint && npm run test:crypto && npm test && npm run build",
    "test:crypto": "node scripts/crypto-smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
