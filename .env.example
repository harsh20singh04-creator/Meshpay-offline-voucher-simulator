NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/upi_offline?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
COOKIE_NAME=upi_session
APP_ORIGIN=http://localhost:5173,http://localhost:5000
JWT_TTL=12h
DEMO_STARTING_BALANCE_PAISE=500000
MAX_TRANSFER_PAISE=2000000
OFFLINE_VOUCHER_TTL_HOURS=72
